---
import BaseLayout from "../layouts/BaseLayout.astro";
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  lang="en"
  title="Page not found | Villa dei Limoni"
  description="The requested Villa dei Limoni page could not be found."
  socialTitle="Page not found — Villa dei Limoni"
  socialDescription="Return to Villa dei Limoni in Camogli."
  pathSuffix=""
  noindex
>
  <main id="main" class="not-found surface-ink">
    <div class="shell">
      <p class="eyebrow eyebrow--light">404 · Camogli</p>
      <h1>The path ends here.</h1>
      <p>The page may have moved. Return to the villa or check current availability on the official listings.</p>
      <div>
        <a class="button button--light" href={base}>Return home</a>
        <a class="button button--light" href={`${base}availability/`}>View availability</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .not-found { display: grid; min-height: 100svh; align-items: center; }
  .not-found > div { padding-block: 6rem; }
  h1 { max-width: 10ch; margin: 0; font-family: var(--font-display); font-size: clamp(4rem, 10vw, 10rem); font-weight: 350; letter-spacing: -.05em; line-height: .86; }
  p:not(.eyebrow) { max-width: 38rem; margin: 2rem 0; color: rgb(244 240 230 / 70%); font-size: 1.1rem; }
  .not-found div div { display: flex; flex-wrap: wrap; gap: .75rem; }
</style>
