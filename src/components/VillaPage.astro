---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navigation from "./Navigation.astro";
import PrototypePicture from "./PrototypePicture.astro";
import Gallery, { type GalleryImage } from "./Gallery.astro";
import SiteFooter from "./SiteFooter.astro";
import { getSiteContent } from "../content";
import { mediaAssets, mediaById } from "../content/media";
import { bookingPlatforms, canonicalFacts, propertyIdentity } from "../data/property-facts";
import type { Locale } from "../types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getSiteContent(locale);
const base = import.meta.env.BASE_URL;
const alternateHref = locale === "en" ? `${base}it/` : base;
const mediaPath = (src: string) => `${base}${src.replace(/^\//, "")}`;
const asset = (id: keyof typeof mediaById) => mediaById[id];

const chapterFor = (item: (typeof mediaAssets)[number]) => {
  if (["outdoor-dining", "outdoor-table", "outdoor-oven"].includes(item.id)) return "outdoor-dining";
  if (item.chapter === "outdoor-life") return "pool-garden";
  if (item.chapter === "interiors") return "living";
  if (item.chapter === "sleeping") return "bedrooms";
  if (item.chapter === "pool-cottage") return "cottage";
  if (item.chapter === "the-villa" || item.chapter === "after-dark") return "views";
  return item.chapter;
};

const galleryOrder = [
  "hero-view",
  "story-facade",
  "outdoor-dining",
  "interior-living",
  "hero-pool",
  "story-citrus",
  "cottage-exterior",
  "bedroom-second-double",
  "outdoor-table",
  "interior-kitchen",
  "camogli-destination",
  "story-sunset",
  "outdoor-oven",
  "bedroom-first-double",
  "cottage-bedroom",
  "access-creuza",
  "interior-dining",
  "finale-night",
];

const galleryImages: GalleryImage[] = galleryOrder
  .map((id) => mediaAssets.find((item) => item.id === id))
  .filter((item): item is (typeof mediaAssets)[number] => Boolean(item))
  .map((item) => ({
    id: item.id,
    src: mediaPath(item.src),
    alt: item.alt[locale],
    caption: item.alt[locale].replace(/^Destination (image|context):\s*/i, ""),
    chapter: chapterFor(item),
    width: item.width,
    height: item.height,
    focalPosition: item.focalPosition,
  }));

const visibleChapters = content.gallery.chapters
  .filter((chapter) => galleryImages.some((image) => image.chapter === chapter.id))
  .map(({ id, label }) => ({ id, label }));

const hero = asset("outdoor-pool-wide");
const storyPrimary = asset("story-facade");
const storySecondary = asset("story-citrus");
const mainVilla = asset("interior-living");
const cottage = asset("cottage-exterior");
const outdoorPrimary = asset("hero-pool");
const outdoorDetail = asset("outdoor-table");
const outdoorOven = asset("outdoor-oven");
const camogli = asset("camogli-destination");
const finale = asset("finale-night");

const canonicalOrigin = Astro.site ?? Astro.url.origin;
const siteUrl = new URL(base, canonicalOrigin).href;
const rentalData = {
  "@type": "VacationRental",
  "@id": `${siteUrl}#villa`,
  name: content.brandName,
  description: content.seo.description,
  url: siteUrl,
  image: new URL(mediaPath(hero.src), canonicalOrigin).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Camogli",
    addressRegion: "Liguria",
    addressCountry: "IT",
  },
  availableLanguage: ["en", "it"],
  currenciesAccepted: "EUR",
  checkoutTime: canonicalFacts.stay.checkout,
  petsAllowed: canonicalFacts.policies.petsAllowed,
  numberOfRooms: {
    "@type": "QuantitativeValue",
    value: canonicalFacts.mainVilla.bedrooms,
    unitText: "bedrooms in the main villa",
  },
  identifier: [
    { "@type": "PropertyValue", propertyID: "CIN", value: propertyIdentity.cin },
    { "@type": "PropertyValue", propertyID: "CITRA", value: propertyIdentity.citra },
  ],
  amenityFeature: [
    { "@type": "LocationFeatureSpecification", name: "Private pool", value: true },
    { "@type": "LocationFeatureSpecification", name: "Sea view", value: true },
    { "@type": "LocationFeatureSpecification", name: "Private garage", value: true },
  ],
  sameAs: [bookingPlatforms.airbnb, bookingPlatforms.vrbo],
};
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${siteUrl}#website`, url: siteUrl, name: propertyIdentity.name, inLanguage: ["en", "it"] },
    rentalData,
    { "@type": "WebPage", "@id": `${Astro.url.href}#page`, url: Astro.url.href, name: content.seo.title, inLanguage: locale, isPartOf: { "@id": `${siteUrl}#website` }, about: { "@id": `${siteUrl}#villa` } },
  ],
};
---

<BaseLayout
  lang={locale}
  title={content.seo.title}
  description={content.seo.description}
  socialTitle={content.seo.socialTitle}
  socialDescription={content.seo.socialDescription}
  alternateHref={alternateHref}
  alternateLang={content.alternateLocale}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <Navigation content={content} />

  <main id="main">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <div class="hero__media" data-motion>
        <PrototypePicture
          src={hero.src}
          alt={hero.alt[locale]}
          width={hero.width}
          height={hero.height}
          focalPosition={hero.focalPosition}
          loading="eager"
          fetchpriority="high"
          sizes="100vw"
        />
      </div>
      <div class="hero__wash"></div>
      <div class="hero__content shell">
        <div class="hero__copy">
          <p class="eyebrow eyebrow--light hero__eyebrow">{content.hero.eyebrow}</p>
          <h1 class="display" id="hero-title">{content.hero.title}</h1>
          <p class="hero__description">{content.hero.description}</p>
          <div class="hero__actions">
            {content.platforms.map((platform) => (
              <a
                class="button button--light"
                href={platform.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={platform.externalLabel}
              >
                {platform.shortCta}<span aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </div>
        <a class="hero__scroll" href="#experience">
          <span>{content.hero.scrollLabel}</span>
          <svg viewBox="0 0 24 38" aria-hidden="true"><path d="M12 1v34m0 0 8-8m-8 8-8-8" /></svg>
        </a>
        <p class="hero__prototype">Local visual prototype · temporary listing imagery</p>
      </div>
    </section>

    <section class="snapshot" aria-label="Property overview">
      <div class="snapshot__track shell">
        {content.facts.map((fact) => (
          <div class="snapshot__fact">
            <strong>{fact.value}</strong>
            <span>{fact.label}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="section experience" id="experience">
      <div class="shell experience__grid">
        <div class="experience__images" data-reveal data-reveal-delay="1" data-motion>
          <figure class="image-wrap experience__portrait">
            <PrototypePicture src={storyPrimary.src} alt={storyPrimary.alt[locale]} width={storyPrimary.width} height={storyPrimary.height} focalPosition={storyPrimary.focalPosition} />
          </figure>
          <figure class="image-wrap experience__detail">
            <PrototypePicture src={storySecondary.src} alt={storySecondary.alt[locale]} width={storySecondary.width} height={storySecondary.height} focalPosition={storySecondary.focalPosition} />
          </figure>
          <span class="experience__number" aria-hidden="true">03</span>
        </div>
        <div class="experience__copy">
          <header class="experience__heading" data-reveal data-motion>
            <p class="eyebrow">{content.story.eyebrow}</p>
            <h2 class="section-title">{content.story.title}</h2>
            <p class="lead">{content.story.lead}</p>
          </header>
          <div class="body-copy experience__body" data-reveal data-reveal-delay="2" data-motion>
            {content.story.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </div>
    </section>

    <section class="section stays" id="stays">
      <div class="shell">
        <header class="stays__header" data-reveal data-motion>
          <div>
            <p class="eyebrow">{content.stays.eyebrow}</p>
            <h2 class="section-title">{content.stays.title}</h2>
          </div>
          <p class="body-copy">{content.stays.intro}</p>
        </header>
        <div class="stay-modes">
          {content.stays.modes.map((mode, index) => {
            const stayImage = index === 0 ? mainVilla : cottage;
            return (
              <article class={`stay-mode stay-mode--${index + 1}`} data-reveal data-reveal-delay={String(index + 1)} data-motion>
                <div class="image-wrap stay-mode__image">
                  <PrototypePicture src={stayImage.src} alt={stayImage.alt[locale]} width={stayImage.width} height={stayImage.height} focalPosition={stayImage.focalPosition} />
                  <span class="stay-mode__index">0{index + 1}</span>
                </div>
                <div class="stay-mode__content">
                  <p class="eyebrow">{mode.eyebrow}</p>
                  <h3>{mode.title}</h3>
                  <p class="stay-mode__summary">{mode.summary}</p>
                  <dl>
                    <div><dt>{content.stays.comparisonLabels.guests}</dt><dd>{mode.capacity}</dd></div>
                    <div><dt>{content.stays.comparisonLabels.bedrooms}</dt><dd>{mode.bedrooms}</dd></div>
                    <div><dt>{content.stays.comparisonLabels.bathrooms}</dt><dd>{mode.bathrooms}</dd></div>
                    <div><dt>{content.stays.comparisonLabels.idealFor}</dt><dd>{mode.idealFor}</dd></div>
                  </dl>
                  <ul>{mode.features.map((feature) => <li>{feature}</li>)}</ul>
                  <p class="stay-mode__note">{mode.note}</p>
                  <a class="text-link stay-mode__cta" href="#booking">{content.navigation.bookLabel}</a>
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="section gallery-section" id="gallery">
      <div class="shell">
        <header class="gallery-section__header" data-reveal data-motion>
          <div>
            <p class="eyebrow">{content.gallery.eyebrow}</p>
            <h2 class="section-title">{content.gallery.title}</h2>
          </div>
          <p class="lead">{content.gallery.intro}</p>
        </header>
        <Gallery
          images={galleryImages}
          chapters={visibleChapters}
          labels={{
            all: content.gallery.allLabel,
            open: content.gallery.openLabel,
            close: content.gallery.closeLabel,
            previous: content.gallery.previousLabel,
            next: content.gallery.nextLabel,
            counter: content.gallery.counterLabel,
          }}
        />
      </div>
    </section>

    <section class="section layout-section surface-ink" id="layout">
      <div class="shell">
        <header class="layout-section__header" data-reveal data-motion>
          <div>
            <p class="eyebrow eyebrow--light">{content.layout.eyebrow}</p>
            <h2 class="section-title">{content.layout.title}</h2>
          </div>
          <div>
            <p class="layout-section__intro">{content.layout.intro}</p>
            <p class="layout-section__good"><span>{content.layout.goodForLabel}</span>{content.layout.goodFor}</p>
          </div>
        </header>
        <div class="floors">
          {content.layout.floors.map((floor, index) => (
            <article class="floor" data-reveal data-motion>
              <div class="floor__number">{String(index).padStart(2, "0")}</div>
              <div class="floor__title">
                <p>{floor.kicker}</p>
                <h3>{floor.name}</h3>
                {floor.optional && <span>{content.layout.optionalLabel}</span>}
              </div>
              <p class="floor__summary">{floor.summary}</p>
              <dl>
                {floor.rooms.map((room) => <div><dt>{room.room}</dt><dd>{room.detail}</dd></div>)}
              </dl>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="outdoors" id="outdoors">
      <div class="outdoors__hero">
        <PrototypePicture src={outdoorPrimary.src} alt={outdoorPrimary.alt[locale]} width={outdoorPrimary.width} height={outdoorPrimary.height} focalPosition={outdoorPrimary.focalPosition} sizes="100vw" />
        <div class="outdoors__wash"></div>
        <div class="shell outdoors__headline" data-reveal data-motion>
          <p class="eyebrow eyebrow--light">{content.outdoors.eyebrow}</p>
          <h2 class="display">{content.outdoors.title}</h2>
          <p>{content.outdoors.lead}</p>
        </div>
      </div>
      <div class="outdoors__details shell">
        <div class="outdoors__quote" data-reveal data-motion>
          <span aria-hidden="true">“</span>
          <p>{content.outdoors.quote}</p>
        </div>
        <div class="outdoors__collage" data-reveal data-reveal-delay="1" data-motion>
          <figure class="image-wrap"><PrototypePicture src={outdoorDetail.src} alt={outdoorDetail.alt[locale]} width={outdoorDetail.width} height={outdoorDetail.height} focalPosition={outdoorDetail.focalPosition} /></figure>
          <figure class="image-wrap"><PrototypePicture src={outdoorOven.src} alt={outdoorOven.alt[locale]} width={outdoorOven.width} height={outdoorOven.height} focalPosition={outdoorOven.focalPosition} /></figure>
        </div>
        <div class="outdoors__features">
          {content.outdoors.features.map((feature, index) => (
            <article data-reveal data-reveal-delay={String((index % 3) + 1)} data-motion>
              <span>0{index + 1}</span>
              <h3>{feature.title}</h3>
              <p>{feature.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section location surface-blue" id="camogli">
      <div class="shell location__grid">
        <figure class="location__image image-wrap" data-reveal data-reveal-delay="1" data-motion>
          <PrototypePicture src={camogli.src} alt={camogli.alt[locale]} width={camogli.width} height={camogli.height} focalPosition={camogli.focalPosition} />
          <figcaption>{locale === "en" ? "Destination image · Camogli" : "Immagine della destinazione · Camogli"}</figcaption>
        </figure>
        <div class="location__text">
          <header class="location__header" data-reveal data-motion>
            <p class="eyebrow eyebrow--light">{content.location.eyebrow}</p>
            <h2 class="section-title">{content.location.title}</h2>
            <p class="lead">{content.location.lead}</p>
          </header>
          <div class="location__copy" data-reveal data-reveal-delay="2" data-motion>
            {content.location.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
        <div class="location__details">
          {content.location.details.map((detail) => (
            <article data-reveal data-motion>
              <strong>{detail.value}</strong><h3>{detail.label}</h3><p>{detail.description}</p>
            </article>
          ))}
        </div>
        <div class="approx-map" aria-label={content.location.mapLabel} data-reveal data-motion>
          <div><span>{content.location.mapLabel}</span><strong>{locale === "en" ? "Above Camogli" : "Sopra Camogli"}</strong><p>{content.location.privacyNote}</p></div>
          <p class="approx-map__place" aria-hidden="true">Golfo<br />Paradiso</p>
        </div>
      </div>
    </section>

    <section class="section reviews" id="reviews">
      <div class="shell reviews__grid">
        <header data-reveal data-motion>
          <p class="eyebrow">{content.reviews.eyebrow}</p>
          <h2 class="section-title">{content.reviews.title}</h2>
          <p class="lead">{content.reviews.intro}</p>
        </header>
        <div class="review-scores">
          {content.reviews.platforms.map((review) => (
            <article data-reveal data-motion>
              <div class="review-score"><strong>{review.score}</strong><span>{review.scale}</span></div>
              <h3>{review.name}</h3>
              <p>{review.reviewCountLabel}</p>
              <ul>{review.themes.map((theme) => <li>{theme}</li>)}</ul>
              <small>{review.verifiedLabel}</small>
              <a
                class="review-scores__link"
                href={content.platforms.find((platform) => platform.id === review.id)?.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {locale === "en" ? `See reviews on ${review.name}` : `Leggi le recensioni su ${review.name}`} ↗
              </a>
            </article>
          ))}
        </div>
        <ol class="proof-points">
          {content.reviews.proofPoints.map((proof, index) => <li data-reveal data-motion><span>0{index + 1}</span>{proof}</li>)}
        </ol>
        <p class="reviews__disclaimer">{content.reviews.disclaimer}</p>
      </div>
    </section>

    <section class="section faq-section" id="faq">
      <div class="shell faq-section__grid">
        <header data-reveal data-motion>
          <p class="eyebrow">{content.faq.eyebrow}</p>
          <h2 class="section-title">{content.faq.title}</h2>
          <p class="body-copy">{content.faq.intro}</p>
        </header>
        <div class="faq-list">
          {content.faq.items.map((item, index) => (
            <details data-reveal data-motion open={index === 0}>
              <summary><span>{String(index + 1).padStart(2, "0")}</span>{item.question}<i aria-hidden="true"></i></summary>
              <div><p>{item.answer}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="booking" id="booking">
      <PrototypePicture src={finale.src} alt={finale.alt[locale]} width={finale.width} height={finale.height} focalPosition={finale.focalPosition} sizes="100vw" />
      <div class="booking__wash"></div>
      <div class="shell booking__content" data-reveal data-motion>
        <p class="eyebrow eyebrow--light">{content.booking.eyebrow}</p>
        <h2 class="display">{content.booking.title}</h2>
        <p class="booking__lead">{content.booking.lead}</p>
        <div class="booking__facts">
          <div><span>{content.booking.rateLabel}</span><strong>{content.booking.rateValue}</strong><p>{content.booking.rateDetail}</p></div>
          <div><span>{content.booking.weeklyLabel}</span><strong>7 {locale === "en" ? "nights" : "notti"}</strong><p>{content.booking.weeklyDetail}</p></div>
          <div><span>{content.booking.taxLabel}</span><strong>{locale === "en" ? "Confirmed at reservation" : "Confermata alla prenotazione"}</strong><p>{content.booking.taxDetail}</p></div>
        </div>
        <div class="booking__actions">
          {content.platforms.map((platform) => (
            <a class="button button--light" href={platform.url} target="_blank" rel="noopener noreferrer" aria-label={platform.externalLabel}>
              {platform.availabilityCta}<span aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
        <p class="booking__note">{content.booking.platformNote}</p>
      </div>
    </section>
  </main>

  <SiteFooter content={content} alternateHref={alternateHref} />

  <div class="mobile-booking">
    <button type="button" data-booking-toggle aria-expanded="false" aria-controls="booking-sheet">{content.navigation.bookLabel}</button>
    <div class="booking-sheet" id="booking-sheet" data-booking-sheet role="dialog" aria-modal="true" aria-label={content.navigation.bookLabel} aria-hidden="true" inert>
      <div>
        <span>{content.booking.eyebrow}</span>
        <button type="button" data-booking-close aria-label={content.navigation.closeLabel}>×</button>
      </div>
      {content.platforms.map((platform) => <a href={platform.url} target="_blank" rel="noopener noreferrer" aria-label={platform.externalLabel}>{platform.availabilityCta}<span>↗</span></a>)}
    </div>
  </div>

  <script>
    const bookingToggle = document.querySelector<HTMLButtonElement>("[data-booking-toggle]");
    const bookingSheet = document.querySelector<HTMLElement>("[data-booking-sheet]");
    const bookingClose = document.querySelector<HTMLButtonElement>("[data-booking-close]");
    const setBookingSheet = (open: boolean) => {
      bookingToggle?.setAttribute("aria-expanded", String(open));
      bookingSheet?.setAttribute("aria-hidden", String(!open));
      if (bookingSheet) bookingSheet.inert = !open;
      document.body.dataset.bookingOpen = String(open);
      if (open) {
        window.dispatchEvent(new CustomEvent("villa:overlay", { detail: "booking" }));
        bookingClose?.focus();
      }
      else bookingToggle?.focus();
    };
    bookingToggle?.addEventListener("click", () => setBookingSheet(bookingToggle.getAttribute("aria-expanded") !== "true"));
    bookingClose?.addEventListener("click", () => setBookingSheet(false));
    document.addEventListener("keydown", (event) => {
      if (bookingToggle?.getAttribute("aria-expanded") !== "true" || !bookingSheet) return;
      if (event.key === "Escape") setBookingSheet(false);
      if (event.key === "Tab") {
        const focusable = Array.from(bookingSheet.querySelectorAll<HTMLElement>("button, a"));
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
        else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (bookingToggle?.getAttribute("aria-expanded") === "true" && !document.querySelector(".mobile-booking")?.contains(event.target as Node)) setBookingSheet(false);
    });
    window.addEventListener("villa:overlay", ((event: CustomEvent<string>) => {
      if (event.detail !== "booking" && bookingToggle?.getAttribute("aria-expanded") === "true") setBookingSheet(false);
    }) as EventListener);
    const bookingSection = document.querySelector("#booking");
    if (bookingSection) {
      const observer = new IntersectionObserver(([entry]) => {
        document.body.dataset.bookingSectionVisible = String(entry.isIntersecting);
      }, { threshold: 0.08 });
      observer.observe(bookingSection);
    }
  </script>
</BaseLayout>

<style>
  .hero { position: relative; min-height: 100svh; overflow: hidden; background: var(--ink); color: var(--paper); }
  .hero__media, .hero__wash { position: absolute; inset: 0; }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.01); animation: hero-breathe 16s var(--ease) both; }
  .hero__wash { background: linear-gradient(90deg, rgb(8 19 17 / 72%) 0%, rgb(8 19 17 / 28%) 56%, rgb(8 19 17 / 16%)), linear-gradient(0deg, rgb(8 19 17 / 55%) 0%, transparent 45%); }
  .hero__content { position: relative; display: flex; min-height: 100svh; align-items: flex-end; padding-top: 8rem; padding-bottom: clamp(3rem, 7vh, 5.5rem); }
  .hero__copy { width: min(58rem, 82%); }
  .hero__eyebrow { margin-bottom: 1.5rem; }
  .hero h1 { max-width: 10ch; text-wrap: balance; }
  .hero__description { max-width: 38rem; margin: 1.75rem 0 0; font-family: var(--font-display); font-size: clamp(1.2rem, 2vw, 1.7rem); font-weight: 350; line-height: 1.4; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.25rem; }
  .hero__scroll { position: absolute; right: 0; bottom: clamp(3rem, 7vh, 5.5rem); display: flex; min-width: 44px; min-height: 44px; align-items: center; gap: 1rem; font-size: .65rem; font-weight: 650; letter-spacing: .13em; text-decoration: none; text-transform: uppercase; writing-mode: vertical-rl; }
  .hero__scroll svg { width: 1rem; height: 2.5rem; fill: none; stroke: currentColor; stroke-width: 1; }
  .hero__prototype { position: absolute; right: 3rem; bottom: .6rem; margin: 0; color: rgb(244 240 230 / 55%); font-size: .55rem; letter-spacing: .08em; text-transform: uppercase; }
  @keyframes hero-breathe { from { transform: scale(1.01); } to { transform: scale(1.055); } }

  .snapshot { background: var(--ink); color: var(--paper); }
  .snapshot__track { display: grid; min-height: 8.5rem; grid-template-columns: repeat(7, 1fr); align-items: stretch; border-top: 1px solid rgb(244 240 230 / 15%); }
  .snapshot__fact { display: flex; flex-direction: column; justify-content: center; padding: 1.25rem clamp(.75rem, 1.4vw, 1.4rem); border-right: 1px solid rgb(244 240 230 / 15%); }
  .snapshot__fact:first-child { padding-left: 0; }
  .snapshot__fact:last-child { border-right: 0; }
