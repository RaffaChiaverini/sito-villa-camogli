---
import type { SiteContent } from "../types";
import { primaryPageNavigation, type PageSlug } from "../content/detail-pages";
import { localeHref, localeNames, locales } from "../content";

interface Props {
  content: SiteContent;
  detailPage?: boolean;
  currentSlug?: PageSlug;
}

const { content, detailPage = false, currentSlug } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeHref = localeHref(content.locale, base);
const routeSuffix = detailPage && currentSlug ? `${currentSlug}/` : "";
const languageLinks = locales.map((locale) => ({ locale, name: localeNames[locale], href: localeHref(locale, base, routeSuffix) }));
const pageHref = (slug: PageSlug) => `${homeHref}${slug}/`;
const ratesLabel = { en: "Rates", it: "Tariffe", fr: "Tarifs", es: "Tarifas" }[content.locale];
const ratesHref = pageHref("rates");
const navigation = detailPage
  ? primaryPageNavigation(content.locale).map((item) => ({
      id: item.slug,
      label: item.label,
      href: pageHref(item.slug),
    }))
  : [...content.navigation.items, { id: "rates", label: ratesLabel, href: ratesHref }];
---

<a class="skip-link" href="#main">{content.navigation.skipLabel}</a>
<header class="site-header" data-header>
  <div class="site-header__inner shell">
    <a class="brand" href={homeHref}>
      <svg class="brand__mark" viewBox="0 0 28 32" aria-hidden="true">
        <path d="M14.4 29.5c.2-11 2.8-20.2 11-27-1 12.6-4.5 22.2-11 27Z"></path>
        <path d="M13.5 29.5C12 20.5 8.3 14.7 1.7 11.2c1.2 8.3 5.4 14.8 11.8 18.3Z"></path>
      </svg>
      <span class="brand__type">
        <span>Villa dei Limoni</span>
        <small>Camogli</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {navigation.map((item) => (
        <a href={item.href} aria-current={detailPage && item.id === currentSlug ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="header-actions">
      <details class="language-menu">
        <summary class="language-link" aria-label={content.navigation.languageLabel}>{content.locale.toUpperCase()}</summary>
        <div class="language-menu__panel">
          {languageLinks.map(({ locale, name, href }) => (
            <a href={href} hreflang={locale} lang={locale} aria-current={locale === content.locale ? "page" : undefined} data-locale-choice={locale}>{name}</a>
          ))}
        </div>
      </details>
      <a class="header-book" href={ratesHref}>{ratesLabel}</a>
      <button
        class="menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={content.navigation.menuLabel}
      >
        <span></span><span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-menu-panel aria-hidden="true" inert>
    <nav aria-label="Mobile navigation">
      {navigation.map((item, index) => (
        <a href={item.href} style={`--menu-index: ${index}`} aria-current={detailPage && item.id === currentSlug ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>
    <div class="mobile-menu__footer">
      <span>Camogli · Liguria</span>
      <div class="mobile-languages" aria-label={content.navigation.languageLabel}>
        {languageLinks.map(({ locale, name, href }) => <a href={href} hreflang={locale} lang={locale} aria-current={locale === content.locale ? "page" : undefined} data-locale-choice={locale}>{name}</a>)}
      </div>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");
  const toggle = document.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-menu-panel]");

  const setMenu = (open: boolean) => {
    if (!toggle || !panel) return;
    toggle.setAttribute("aria-expanded", String(open));
    panel.setAttribute("aria-hidden", String(!open));
    panel.inert = !open;
    document.body.dataset.menuOpen = String(open);
    if (open) {
      window.dispatchEvent(new CustomEvent("villa:overlay", { detail: "menu" }));
      panel.querySelector<HTMLElement>("a")?.focus();
    } else toggle.focus();
  };

  toggle?.addEventListener("click", () => {
    setMenu(toggle.getAttribute("aria-expanded") !== "true");
  });
  panel?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
  window.addEventListener("villa:overlay", ((event: CustomEvent<string>) => {
    if (event.detail !== "menu" && toggle?.getAttribute("aria-expanded") === "true") setMenu(false);
  }) as EventListener);
  document.addEventListener("keydown", (event) => {
    if (toggle?.getAttribute("aria-expanded") !== "true") return;
    if (event.key === "Escape") setMenu(false);
    if (event.key === "Tab" && panel) {
      const focusable = [toggle, ...Array.from(panel.querySelectorAll<HTMLElement>("a, button"))];
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
    }
  });

  const updateHeader = () => header?.toggleAttribute("data-scrolled", window.scrollY > 48);
  updateHeader();
  window.addEventListener("scroll", updateHeader, { passive: true });
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 90;
    top: 0;
    right: 0;
    left: 0;
    color: var(--paper);
    transition:
      color 500ms var(--ease),
      background-color 500ms var(--ease),
      box-shadow 500ms var(--ease);
  }

  .site-header[data-scrolled] {
    background: rgb(251 248 241 / 94%);
    box-shadow: 0 1px 0 var(--rule);
    color: var(--ink);
    backdrop-filter: blur(14px);
  }

  .site-header__inner {
    position: relative;
    z-index: 2;
    display: grid;
    min-height: 5.5rem;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
  }

  .brand {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    justify-self: start;
    gap: 0.7rem;
    text-decoration: none;
  }

  .brand__mark {
    width: 1.45rem;
    fill: currentColor;
  }

  .brand__type {
    display: grid;
    font-family: var(--font-display);
    font-size: 1.08rem;
    font-weight: 430;
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .brand__type small {
    margin-top: 0.28rem;
    font-family: var(--font-body);
    font-size: 0.52rem;
    font-weight: 600;
    letter-spacing: 0.23em;
    text-transform: uppercase;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.2rem, 2.4vw, 2.5rem);
  }

  .desktop-nav a,
  .language-link,
  .header-book {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    font-size: 0.65rem;
    font-weight: 650;
    letter-spacing: 0.11em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .desktop-nav a::after {
    position: absolute;
    right: 0;
    bottom: 0.55rem;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 450ms var(--ease);
  }

  .desktop-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-self: end;
    gap: 1.5rem;
  }

  .language-menu { position: relative; }
  .language-menu summary { list-style: none; cursor: pointer; }
  .language-menu summary::-webkit-details-marker { display: none; }
  .language-menu__panel {
    position: absolute;
    top: calc(100% - .15rem);
    right: 0;
    display: grid;
    min-width: 9rem;
    padding: .5rem;
    border: 1px solid var(--rule);
    background: rgb(251 248 241 / 98%);
    box-shadow: 0 .75rem 2rem rgb(8 19 17 / 14%);
    color: var(--ink);
  }
  .language-menu__panel a { min-height: 2.5rem; padding: .65rem .75rem; font-size: .65rem; font-weight: 650; letter-spacing: .08em; text-decoration: none; text-transform: uppercase; }
  .language-menu__panel a:hover { background: var(--sand); }
  .language-menu__panel a[aria-current="page"] { color: var(--ink-soft); }
  .mobile-languages { display: flex; flex-wrap: wrap; gap: .25rem 1rem; }

  .header-book {
    padding-inline: 1rem;
    border: 1px solid currentColor;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .menu-toggle span {
    position: absolute;
    width: 1.35rem;
    height: 1px;
    background: currentColor;
    transition: transform 400ms var(--ease);
  }

  .menu-toggle span:first-child { transform: translateY(-4px); }
  .menu-toggle span:last-child { transform: translateY(4px); }
  .menu-toggle[aria-expanded="true"] span:first-child { transform: rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:last-child { transform: rotate(-45deg); }

  .mobile-menu {
    display: none;
  }

  @media (max-width: 70rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .header-book {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .mobile-menu {
      position: fixed;
      z-index: 1;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 7.5rem max(1.5rem, calc((100vw - 92rem) / 2));
      background: var(--ink);
      color: var(--paper);
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transform: translateY(-1rem);
      transition:
        opacity 450ms var(--ease),
        transform 450ms var(--ease),
        visibility 0s linear 450ms;
    }

    .mobile-menu[aria-hidden="false"] {
      opacity: 1;
      pointer-events: auto;
      visibility: visible;
      transform: none;
      transition-delay: 0s;
    }

    .mobile-menu nav {
      display: grid;
      gap: 0.15rem;
    }

    .mobile-menu nav a {
      display: flex;
      min-height: 54px;
      align-items: center;
      border-bottom: 1px solid rgb(244 240 230 / 15%);
      font-family: var(--font-display);
      font-size: clamp(2rem, 7vw, 4rem);
      font-weight: 380;
      letter-spacing: -0.025em;
      line-height: 1.1;
      text-decoration: none;
    }

  .mobile-menu__footer {
      display: flex;
      justify-content: space-between;
      margin-top: 3rem;
      font-size: 0.67rem;
      font-weight: 600;
      letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .mobile-menu__footer a {
    display: inline-flex;
    min-width: 44px;
    min-height: 44px;
    align-items: center;
    justify-content: flex-end;
  }

    body[data-menu-open="true"] .site-header {
      color: var(--paper);
    }
  }

  @media (max-width: 34rem) {
    .site-header__inner {
      min-height: 4.75rem;
    }

    .brand__type span { font-size: 0.95rem; }
    .language-link { display: none; }
    .header-actions { gap: 0; }
  }
</style>
