---
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  focalPosition?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  sizes?: string;
  class?: string;
}

const {
  src,
  alt,
  width,
  height,
  focalPosition = "50% 50%",
  loading = "lazy",
  fetchpriority,
  sizes = "(max-width: 768px) 100vw, 50vw",
  class: className,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const jpeg = `${base}${src.replace(/^\//, "")}`;
const avif = jpeg.replace(/\.jpg$/i, ".avif");
const webp = jpeg.replace(/\.jpg$/i, ".webp");
const avif640 = jpeg.replace(/\.jpg$/i, "-640.avif");
const avif960 = jpeg.replace(/\.jpg$/i, "-960.avif");
const webp640 = jpeg.replace(/\.jpg$/i, "-640.webp");
const webp960 = jpeg.replace(/\.jpg$/i, "-960.webp");
---

<picture class={className}>
  <source srcset={`${avif640} 640w, ${avif960} 960w, ${avif} ${width}w`} sizes={sizes} type="image/avif" />
  <source srcset={`${webp640} 640w, ${webp960} 960w, ${webp} ${width}w`} sizes={sizes} type="image/webp" />
  <img
    src={jpeg}
    alt={alt}
    width={width}
    height={height}
    loading={loading}
    decoding="async"
    fetchpriority={fetchpriority}
    sizes={sizes}
    style={`object-position:${focalPosition}`}
  />
</picture>

<style>
  picture {
    display: block;
    width: 100%;
    height: 100%;
  }

  picture img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
